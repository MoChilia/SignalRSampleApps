<?xml version="1.0" encoding="utf-8"?>
<!-- See dev-setup.txt in this folder for instructions on building the local aspnetcore packages. -->
<configuration>
  <packageSources>
    <clear />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="local-aspnetcore" value="%USERPROFILE%\aspnetcore\artifacts\packages\Debug\Shipping" />
  </packageSources>
</configuration>
